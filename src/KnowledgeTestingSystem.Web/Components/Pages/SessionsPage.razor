@* Components/Pages/SessionsPage.razor *@
@page "/sessions"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using KnowledgeTestingSystem.Web.Shared
@inject NavigationManager NavigationManager
@inject SessionService SessionService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Тестовые сессии</PageTitle>

<div class="sessions-main-container">
    <div class="sessions-main-content">
        <div class="search-bar">
            <input type="text" placeholder="Поиск сессии..." @bind="SearchTerm" @bind:event="oninput" />
        </div>
        <div class="session-list">
            @if (isLoading)
            {
                <p><em>Загрузка сессий...</em></p>
            }
            else if (displaySessions == null || !displaySessions.Any())
            {
                <p><em>Доступные сессии не найдены.</em></p>
            }
            else
            {
                @foreach (var session in displaySessions)
                {
                    <div class="session-item">
                        <div class="session-name">@session.Name</div>
                        <div class="session-action">
                            @switch (session.Status)
                            {
                                case SessionListComponent.SessionStatus.Completed:
                                    <button class="btn-results" @onclick="() => ShowResults(session.Id)">Результаты</button>
                                    break;
                                case SessionListComponent.SessionStatus.InProgress:
                                    <button class="btn-continue" @onclick="() => ContinueSession(session.Id)">Продолжить</button>
                                    break;
                                case SessionListComponent.SessionStatus.NotStarted:
                                    <button class="btn-start" @onclick="() => StartSession(session.Id)">Начать</button>
                                    break;
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private string _searchTerm = string.Empty;
    public string SearchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                FilterDisplaySessions();
            }
        }
    }
    private List<SessionListComponent.TestSessionView>? allUserSessions;
    private List<SessionListComponent.TestSessionView>? displaySessions;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            allUserSessions = await SessionService.GetSessionsForUserAsync(user);
        }

        FilterDisplaySessions();
        isLoading = false;
    }

    private void FilterDisplaySessions()
    {
        if (allUserSessions == null)
        {
            displaySessions = new List<SessionListComponent.TestSessionView>();
            return;
        }

        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            displaySessions = allUserSessions;
        }
        else
        {
            displaySessions = allUserSessions
                .Where(s => s.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void ShowResults(int sessionId)
    {
        NavigationManager.NavigateTo($"/session-results/{sessionId}");
    }

    private void ContinueSession(int sessionId)
    {
        NavigationManager.NavigateTo($"/pre-test/{sessionId}");
    }

    private void StartSession(int sessionId)
    {
        NavigationManager.NavigateTo($"/pre-test/{sessionId}");
    }
}