    private VariableInputData CloneVariableInputData(VariableInputData original)
    {
        return new VariableInputData
            {
                Name = original.Name, // Копируем Name
            // Label = original.Label, // <<< ЭТУ СТРОКУ НУЖНО УДАЛИТЬ ИЛИ ЗАКОММЕНТИРОВАТЬ
            // Label будет вычислен автоматически на основе Name
                CurrentValue = original.CurrentValue,
                IsArray = original.IsArray,
                ArrayCellValues = new List<string?>(original.ArrayCellValues ?? new List<string?>()), // Добавил ?? new List для nullable
                ArrayLength = original.ArrayLength,
                IsTwoDimensional = original.IsTwoDimensional,
                TwoDArrayCellValues = original.TwoDArrayCellValues?.Select(row => new List<string?>(row ?? new List<string?>())).ToList(), // Добавил ?? new List для nullable
                ArrayRows = original.ArrayRows,
                ArrayCols = original.ArrayCols,
                MaxCellsPerDimension = original.MaxCellsPerDimension,
                PlaceholderText = original.PlaceholderText,
                Status = original.Status,
                ErrorMessageForUI = original.ErrorMessageForUI
            };
    }

