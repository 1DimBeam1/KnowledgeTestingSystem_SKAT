    private async Task AddNextStepInstance(ActiveStepInstance? previousStepInstance, AlgorithmStepInfo nextStepTemplate)
    {
        if (IsProcessingAction) return;
        if (nextStepTemplate == null || nextStepTemplate.OriginalStepNumberInDb == 0) return;

        var newInstance = new ActiveStepInstance
            {
                OriginalStepNumber = nextStepTemplate.OriginalStepNumberInDb,
                Description = nextStepTemplate.ParsedDescription, // Записываем чистое описание
                DisplayStepNumberFromAlgo = nextStepTemplate.DisplayStepNumber, // Записываем номер для отображения
                DisplayOrder = DisplayedStepInstances.Any() ? DisplayedStepInstances.Max(di => di.DisplayOrder) + 1 : 1,
                UserInputs = new List<VariableInputData>()
            };

        // Если есть предыдущие шаги, ищем последний и увеличиваем DisplayOrder
        if (DisplayedStepInstances.Any())
        {
            newInstance.DisplayOrder = DisplayedStepInstances.Max(di => di.DisplayOrder) + 1;
        }
        else
        {
            newInstance.DisplayOrder = 1; // Самый первый шаг
        }


        foreach (var trackedVarInfo in nextStepTemplate.VariablesToTrack)
        {
            var inputDataItem = new VariableInputData
                {
                    Name = trackedVarInfo.Name,
                    IsArray = trackedVarInfo.IsArrayType,
                    IsTwoDimensional = trackedVarInfo.IsTwoDimensionalArray,
                    PlaceholderText = trackedVarInfo.PlaceholderTextSingle
                };

            if (trackedVarInfo.IsArrayType)
            {
                if (trackedVarInfo.IsTwoDimensionalArray)
                {
                    inputDataItem.ArrayRows = Math.Max(1, trackedVarInfo.ArrayDimension1Size);
                    inputDataItem.ArrayCols = Math.Max(1, trackedVarInfo.ArrayDimension2Size);
                    inputDataItem.TwoDArrayCellValues = new List<List<string?>>();
                    for (int r = 0; r < inputDataItem.ArrayRows; r++)
                    {
                        inputDataItem.TwoDArrayCellValues.Add(new List<string?>(new string?[inputDataItem.ArrayCols]));
                    }
                }
                else // Одномерный
                {
                    inputDataItem.ArrayLength = Math.Max(1, trackedVarInfo.ArrayDimension1Size);
                    inputDataItem.ArrayCellValues = new List<string?>(new string?[inputDataItem.ArrayLength]);
                }
            }
            newInstance.UserInputs.Add(inputDataItem);
        }
        DisplayedStepInstances.Add(newInstance);
        DisplayedStepInstances = DisplayedStepInstances.OrderBy(di => di.DisplayOrder).ToList(); // На всякий случай, если порядок важен

        await SaveTaskSpecificStateAsync();
        StateHasChanged();
    }

