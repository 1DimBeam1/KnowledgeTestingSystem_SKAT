    // --- Таймер ---
    private void InitializeAndStartTimer(bool useSessionTimeLimitAsInitial = true)
    {
        if (useSessionTimeLimitAsInitial || _totalSecondsRemaining <= 0)
        {
            _totalSecondsRemaining = (int)sessionTimeLimit.TotalSeconds;
        }
        UpdateTimeRemainingDisplay(); _timer?.Dispose();
        if (_totalSecondsRemaining > 0)
        {
            _timer = new System.Threading.Timer(TimerTick, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
        else if (sessionTimeLimit == TimeSpan.Zero)
        {
            timeRemainingDisplay = "Без ограничений";
        }
        else { timeRemainingDisplay = "00:00:00"; if (!isLoadingInitialData && !IsProcessingAction) InvokeAsync(HandleTimeExpired); }
    }

    private async void TimerTick(object? state) // async void
    {
        bool shouldStopTimer = false;
        if (_totalSecondsRemaining > 0)
        {
            _totalSecondsRemaining--;
            UpdateTimeRemainingDisplay();
            if (_totalSecondsRemaining % 10 == 0) // Периодическое сохранение
            {
                await SaveGlobalProgressAsync(); // Сохраняем только время и индекс задания
            }
        }
        else
        {
            _totalSecondsRemaining = 0;
            UpdateTimeRemainingDisplay();
            shouldStopTimer = true;
        }

        await InvokeAsync(StateHasChanged);

        if (shouldStopTimer)
        {
            _timer?.Dispose();
            _timer = null;
            await InvokeAsync(HandleTimeExpired);
        }
    }

    private void UpdateTimeRemainingDisplay()
    {
        if (sessionTimeLimit == TimeSpan.Zero)
        {
            timeRemainingDisplay = "Без ограничений";
            return;
        }
        TimeSpan ts = TimeSpan.FromSeconds(_totalSecondsRemaining);
        timeRemainingDisplay = $"{Math.Floor(ts.TotalHours):00}:{ts.Minutes:D2}:{ts.Seconds:D2}";
    }

    private async Task HandleTimeExpired()
    {
        Console.WriteLine("Время сессии истекло!");
        _timer?.Dispose(); _timer = null;
        SaveCurrentTaskStateToFullState();
        // Здесь НЕ вызываем CheckCurrentTaskSolutionAsync, так как нам нужно отправить ВСЕ накопленные данные
        // Собираем все данные аналогично блоку "Завершить сессию" в GoToNextTaskOrFinishSession
        IsProcessingAction = true; StateHasChanged();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (userIdClaim == null || !int.TryParse(userIdClaim.Value, out int userId))
        {
            await ProcessSessionCompletion("timeout_user_error", null); return;
        }

        var allTestAttemptsForSession = new List<TestAttemptDto>();
        foreach (var taskInfo in sessionTasks)
        {
            TestSessionTaskState? taskState = null;
            try { var sr = await ProtectedSessionStore.GetAsync<TestSessionTaskState>(TaskSpecificStateKey(taskInfo.TestId)); if (sr.Success) taskState = sr.Value; } catch { }
            if (taskState != null)
            {
                var attempt = new TestAttemptDto { TestId = taskInfo.TestId };
                // Проверяем, есть ли сохраненное состояние для этого задания
                if (currentSessionFullState.TaskStates.TryGetValue(taskInfo.TestId, out taskState))
                {
                    // Если состояние есть и оно не пустое, собираем реальные данные
                    attempt = new TestAttemptDto { TestId = taskInfo.TestId };

                    // Собираем данные из DisplayedSteps
                    foreach (var instance in taskState.DisplayedSteps)
                    {
                        foreach (var userInput in instance.UserInputs)
                        {
                            attempt.Variables.Add(new VariableSubmissionDto
                                {
                                    Sequence = instance.DisplayOrder,
                                    Step = instance.OriginalStepNumber,
                                    VariableName = userInput.Name,
                                    VariableValue = userInput.IsArray ? string.Join(",", userInput.ArrayCellValues.Select(c => c ?? "")) : (userInput.CurrentValue ?? "")
                                });
                        }
                    }
                }
                else
                {
                    // Если состояния нет ИЛИ оно пустое, создаем заглушку
                    Console.WriteLine($"Создание заглушки для пропущенного задания TestId: {taskInfo.TestId}");
                    attempt = new TestAttemptDto
                        {
                            TestId = taskInfo.TestId,
                            Variables = new List<VariableSubmissionDto>
                    {
                        // Создаем одну переменную-заглушку, как вы описали
                        new VariableSubmissionDto
                        {
                            Sequence = 1,
                            Step = 1,
                            VariableName = "skip", // или "string", или другое понятное значение
                            VariableValue = "0" // или "string"
                        }
                    }
                        };
                }
                allTestAttemptsForSession.Add(attempt);
            }
        }

        if (!allTestAttemptsForSession.Any())
        {
            await ProcessSessionCompletion("timeout_no_data", null); return;
        }

        var finalRequest = new EvaluationUpdateRequestDto { /* ... */ Tests = allTestAttemptsForSession };
        lastEvaluationResult = await EvaluationService.UpdateEvaluationAsync(finalRequest);
        await ProcessSessionCompletion("timeout", lastEvaluationResult?.Score);
    }

    private void GoBackToSessions() { NavigationManager.NavigateTo("/sessions"); }
    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
        // Вызов SaveProgressAsync здесь может быть проблематичным из-за синхронного контекста Dispose
        // и асинхронной природы ProtectedSessionStore. Если очень нужно, рассмотрите IAsyncDisposable.
        // Console.WriteLine("ActualTestPage disposed, attempting to save progress if any...");
        // Task.Run(async () => await SaveProgressAsync()).GetAwaiter().GetResult(); // Блокирующий вызов - плохо
        Console.WriteLine("ActualTestPage disposed, timer stopped.");
    }
}