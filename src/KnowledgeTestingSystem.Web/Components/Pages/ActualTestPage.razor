        {
            nextButtonText = "Следующее задание";
        }
        else
        {
            nextButtonText = "Завершить сессию";
        }
    }



    private async Task AddStepInstanceBasedOnAlgorithmStep(AlgorithmStepInfo algoStep) // async Task
    {
        if (algoStep == null || algoStep.OriginalStepNumberInDb == 0) return;

        var newInstance = new ActiveStepInstance
            {
                OriginalStepNumber = algoStep.OriginalStepNumberInDb,
                Description = algoStep.ParsedDescription,   
                DisplayOrder = DisplayedStepInstances.Count + 1, // Устанавливаем DisplayOrder
                UserInputs = new List<VariableInputData>()
            };

        foreach (var trackedVarInfo in algoStep.VariablesToTrack)
        {
            var inputDataItem = new VariableInputData
                {
                    Name = trackedVarInfo.Name,
                    IsArray = trackedVarInfo.IsArrayType,
                    IsTwoDimensional = trackedVarInfo.IsTwoDimensionalArray,
                    PlaceholderText = trackedVarInfo.PlaceholderTextSingle
                };

            if (trackedVarInfo.IsArrayType)
            {
                if (trackedVarInfo.IsTwoDimensionalArray)
                {
                    inputDataItem.ArrayRows = Math.Max(1, trackedVarInfo.ArrayDimension1Size);
                    inputDataItem.ArrayCols = Math.Max(1, trackedVarInfo.ArrayDimension2Size);
                    inputDataItem.TwoDArrayCellValues = new List<List<string?>>();
                    for (int r = 0; r < inputDataItem.ArrayRows; r++)
                    {
                        inputDataItem.TwoDArrayCellValues.Add(new List<string?>(new string?[inputDataItem.ArrayCols]));
                    }
                }
                else // Одномерный
                {
                    inputDataItem.ArrayLength = Math.Max(1, trackedVarInfo.ArrayDimension1Size);
                    inputDataItem.ArrayCellValues = new List<string?>(new string?[inputDataItem.ArrayLength]);
                }
            }
            newInstance.UserInputs.Add(inputDataItem);
        }

        DisplayedStepInstances.Add(newInstance);
        await SaveCurrentTaskProgressAsync(); // Сохраняем состояние текущего задания
        //await SaveFullSessionStateAsync();
        StateHasChanged();
    }

    private string GetInstanceStatusClass(StepStatus status) => status switch
    {
        StepStatus.Correct => "atp-instance-correct",
        StepStatus.Incorrect => "atp-instance-incorrect",
        StepStatus.Pending => "atp-instance-pending", // Ожидание ответа от сервера
        StepStatus.Submitted => "atp-instance-submitted", // Отправлено в контрольном режиме, результат см. в общем балле
        StepStatus.NotChecked => "atp-instance-notchecked",
        _ => "atp-instance-notchecked"
    };

    private async Task CheckCurrentTaskSolutionAsync()
    {
        if (currentTask == null || IsCheckingSolution || currentTestMode != PreTestPage.TestMode.Training) return;
        // --- ПРОВЕРКА ЗАПОЛНЕНИЯ ПОЛЕЙ ---
        bool allFieldsFilled = true;
        // Проверка DisplayedStepInstances
        foreach (var instance in DisplayedStepInstances)
        {
            foreach (var userInput in instance.UserInputs)
            {
                if (userInput.IsArray)
                {
                    if (userInput.ArrayCellValues.Any(cell => string.IsNullOrWhiteSpace(cell)))
                    {
                        allFieldsFilled = false;
                        userInput.ErrorMessageForUI = "Все ячейки массива должны быть заполнены";
                    }
                    else { userInput.ErrorMessageForUI = null; }
                }
                else if (string.IsNullOrWhiteSpace(userInput.CurrentValue))
                {
                    allFieldsFilled = false;
                    userInput.ErrorMessageForUI = "Поле не должно быть пустым";
                }
                else { userInput.ErrorMessageForUI = null; }
            }
        }

        if (!allFieldsFilled)
        {
            fieldValidationErrorMessage = "Пожалуйста, заполните все обязательные поля для ввода шагов.";
            StateHasChanged(); // Обновить UI для отображения сообщений об ошибках
            return; // Прерываем проверку, если не все поля заполнены
        }
        // --- КОНЕЦ ПРОВЕРКИ ЗАПОЛНЕНИЯ ПОЛЕЙ ---

        IsProcessingAction = true;
        IsCheckingSolution = true;

        foreach (var instance in DisplayedStepInstances) { instance.Status = StepStatus.NotChecked; instance.ErrorMessageForUI = null; }
        StateHasChanged();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (userIdClaim == null || !int.TryParse(userIdClaim.Value, out int userId))
        {
            loadingErrorMessage = "Ошибка: не удалось определить пользователя.";
            hasLoadingError = true;
            StateHasChanged();
            return;
        }

        // Сбрасываем статусы или устанавливаем в Pending перед новой проверкой
        foreach (var instance in DisplayedStepInstances) instance.Status = StepStatus.Pending;
        // TODO: Аналогично для StepZeroUserInputs, если они оцениваются и имеют статус
        StateHasChanged(); // Показать, что идет проверка

        var testAttempt = new TestAttemptDto { TestId = currentTask.TestId };

        // 1. Собираем данные из StepZeroUserInputs
        // if (StepZeroUserInputs.Any())
        // {
        //     int stepZeroVarSequence = 0; // Локальный счетчик для переменных Шага 0
        //     foreach (var userInput in StepZeroUserInputs)
        //     {
        //         string valueToSubmit = userInput.IsArray ?
        //             string.Join(",", userInput.ArrayCellValues.Select(cell => cell ?? "")) :
        //             (userInput.CurrentValue ?? "");

        //         testAttempt.Variables.Add(new VariableSubmissionDto
        //             {
        //                 Sequence = stepZeroVarSequence++, // Последовательность переменной ВНУТРИ шага 0
        //                 Step = 0, // Идентификатор Шага 0
        //                 VariableName = userInput.Name,
        //                 VariableValue = valueToSubmit
        //             });
        //     }
        // }

        // 2. Собираем данные из DisplayedStepInstances
        foreach (var instance in DisplayedStepInstances)
        {
            foreach (var userInput in instance.UserInputs)
            {
                string valueToSubmit;
                if (userInput.IsArray)
                {
                    if (userInput.IsTwoDimensional)
                    {
                        // Сериализуем 2D массив в строку: "1,2,3;4,5,6"
                        valueToSubmit = string.Join(";",
                            userInput.TwoDArrayCellValues.Select(row =>
                                string.Join(",", row.Select(cell => cell ?? ""))
                            )
                        );
                    }
                    else // Одномерный
                    {
                        valueToSubmit = string.Join(",", userInput.ArrayCellValues.Select(cell => cell ?? ""));
                    }
                }
                else
                {
                    valueToSubmit = userInput.CurrentValue ?? "";
                }

                testAttempt.Variables.Add(new VariableSubmissionDto
                    {
                        Sequence = instance.DisplayOrder, // Идентификатор экземпляра шага (порядковый номер на экране)
                        Step = instance.OriginalStepNumber, // Номер шага из определения алгоритма
                        VariableName = userInput.Name,
                        VariableValue = valueToSubmit
                    });
            }
        }

        await ClearTables();

        var evaluationRequest = new EvaluationUpdateRequestDto
            {
                UserId = userId,
                SessionId = SessionId,
                Type = (int)currentTestMode,
                Tests = new List<TestAttemptDto> { testAttempt }
            };

        var evaluationResult = await EvaluationService.UpdateEvaluationAsync(evaluationRequest);

        if (evaluationResult != null)
        {
            var errorsFromApi = evaluationResult.Errors ?? new List<ErrorDto>();
            foreach (var instance in DisplayedStepInstances) instance.Status = StepStatus.Correct; // Предполагаем правильность

            int maxUserStepSequence = DisplayedStepInstances.Any() ? DisplayedStepInstances.Max(di => di.DisplayOrder) : 0;
            int maxErrorStepSequence = errorsFromApi.Where(e => e.Sequence.HasValue).Select(e => e.Sequence.Value).DefaultIfEmpty(0).Max();

            if (maxErrorStepSequence > maxUserStepSequence)
            {
                // Сохраняем это сообщение для отображения в UI
                // Мы можем использовать fieldValidationErrorMessage или новое свойство.
                fieldValidationErrorMessage = "Ваше решение не закончено. Проверьте последовательность шагов.";
                Console.WriteLine("Обнаружена ошибка: решение не закончено (ошибки для не добавленных шагов).");
            }

            foreach (var error in errorsFromApi)
            {
                if (error.TestId == currentTask.TestId) // Ошибка для текущего теста
                {
                    ActiveStepInstance? instanceWithError = null;
                    instanceWithError = DisplayedStepInstances
                            .FirstOrDefault(di => di.DisplayOrder == error.Sequence && di.OriginalStepNumber == error.Step);

                    if (instanceWithError != null)
                    {
                        instanceWithError.Status = StepStatus.Incorrect;
                        instanceWithError.ErrorMessageForUI = ParseErrorMessage(error.Message, error);
                    }
                    else if (error.Step != 0) // Если ошибка не для шага 0, но инстанс не найден
                    {
                        Console.WriteLine($"Не найден экземпляр шага для ошибки: TestId={error.TestId}, Sequence={error.Sequence}, Step={error.Step}, VarName={error.VariableName}, Msg='{error.Message}'");
                    }
                }
            }
        }
        else
        {
            loadingErrorMessage = "Не удалось получить результат оценки (ответ null).";
            hasLoadingError = true;
            Console.WriteLine(loadingErrorMessage);
            // Помечаем все шаги как не проверенные, так как ответ не пришел
            foreach (var instance in DisplayedStepInstances) instance.Status = StepStatus.NotChecked;
        }
        await SaveCurrentTaskProgressAsync(); // Сохраняем обновленные статусы и введенные данные
        IsProcessingAction = false; 
        IsCheckingSolution = false; 
        StateHasChanged();
    }

    private string ParseErrorMessage(string apiMessage, ErrorDto errorDetails)
    {
        // Приводим к нижнему регистру для более надежного сравнения
        string lowerApiMessage = apiMessage.ToLowerInvariant();

        if (lowerApiMessage.Contains("contains variables not matching true program step"))
        {
            return "Не тот шаг алгоритма, перепроверьте решение.";
        }
        // Для "Invalid step for testId..." нам нужны параметры из errorDetails
        if (lowerApiMessage.StartsWith($"invalid step for testid={errorDetails.TestId?.ToString().ToLowerInvariant()}, sequence={errorDetails.Sequence?.ToString().ToLowerInvariant()}, step={errorDetails.Step?.ToString().ToLowerInvariant()}"))
        {
            return "Не тот шаг алгоритма, перепроверьте решение.";
        }
        if (lowerApiMessage.Contains("does not exist in program execution"))
        {
            return "Возможно это лишний или неподходящий шаг, перепроверьте решение.";
        }
        if (lowerApiMessage.Contains("incorrect value for")) // "Incorrect value for {userVar.VariableName}: expected {substituteValue}, got {userValue}, mismatches={total - matches}"
        {
            return $"Не то значение переменной {errorDetails.VariableName ?? ""}, перепроверьте решение.";
        }
        if (lowerApiMessage.Contains("пользователь имеет лишние шаги")) // "Пользователь имеет лишние шаги, начиная с sequence={programMaxStep + 1}"
        {
            return "Ваше решение избыточно, перепроверьте решение.";
        }
        if (lowerApiMessage.Contains("No matching value in substitute-values for") || lowerApiMessage.Contains("Неверный номер шага"))
        {
            return "Не тот шаг алгоритма, перепроверьте решение.";
        }
        // Если ни одно из известных сообщений не подошло, возвращаем оригинальное (или более общее)
        Console.WriteLine($"Нераспознанное сообщение об ошибке API: '{apiMessage}' для Step: {errorDetails.Step}, Seq: {errorDetails.Sequence}, Var: {errorDetails.VariableName}");
        return "Обнаружена ошибка в этом шаге. Детали: " + apiMessage; // Или просто "Перепроверьте этот шаг."
    }

    private async Task GoToNextTaskOrFinishSession()
    {

        if (IsProcessingAction) return;
        IsProcessingAction = true; 
        StateHasChanged();
        fieldValidationErrorMessage = null; // Сброс перед проверкой

        // --- ПРОВЕРКА ЗАПОЛНЕНИЯ ПОЛЕЙ ТЕКУЩЕГО ЗАДАНИЯ ---
        bool currentTaskFieldsFilled = true;
        if (currentTask != null) // Проверяем только если есть текущее задание
        {
            foreach (var instance in DisplayedStepInstances)
            {
                foreach (var userInput in instance.UserInputs)
                {
                    if (userInput.IsArray ? userInput.ArrayCellValues.Any(string.IsNullOrWhiteSpace) : string.IsNullOrWhiteSpace(userInput.CurrentValue))
                    { currentTaskFieldsFilled = false; userInput.ErrorMessageForUI = "Заполните поле"; }
                    else { userInput.ErrorMessageForUI = null; }
                }
            }
        }

        if (!currentTaskFieldsFilled)
        {
            fieldValidationErrorMessage = "Пожалуйста, заполните все поля текущего задания перед переходом.";
            IsProcessingAction = false; StateHasChanged();
            return;
        }
        // --- КОНЕЦ ПРОВЕРКИ ---

        // Сначала сохраняем состояние текущего (уходящего) задания
        SaveCurrentTaskStateToFullState();
        await SaveCurrentTaskProgressAsync();

        if (currentTaskIndex < sessionTasks.Count - 1)
        {
            currentTaskIndex++;
            await SaveGlobalProgressAsync(); // Сохраняем новый индекс текущего задания и оставшееся время
            await SetCurrentTask(currentTaskIndex);
            IsProcessingAction = false; // Разблокируем после загрузки следующего задания
            // StateHasChanged(); // Вызовется в SetCurrentTask
        }
        else // Это кнопка "Завершить сессию"
        {
            // Собираем ВСЕ данные для ВСЕХ заданий и отправляем на оценку
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim == null || !int.TryParse(userIdClaim.Value, out int userId))
            {
                loadingErrorMessage = "Ошибка: не удалось определить пользователя для завершения."; hasLoadingError = true;
                IsProcessingAction = false; StateHasChanged(); return;
            }

            var allTestAttemptsForSession = new List<TestAttemptDto>();
            foreach (var taskInfo in sessionTasks)
            {
                TestSessionTaskState? taskState = null;
                try { var sr = await ProtectedSessionStore.GetAsync<TestSessionTaskState>(TaskSpecificStateKey(taskInfo.TestId)); if (sr.Success) taskState = sr.Value; } catch { }
                TestAttemptDto attempt;

                // Проверяем, есть ли сохраненное состояние для этого задания
                if (currentSessionFullState.TaskStates.TryGetValue(taskInfo.TestId, out taskState) && taskState.DisplayedSteps.Count > 0)
                {
                    // Если состояние есть и оно не пустое, собираем реальные данные
                    attempt = new TestAttemptDto { TestId = taskInfo.TestId };

                    // Собираем данные из DisplayedSteps
                    foreach (var instance in taskState.DisplayedSteps)
                    {
                        foreach (var userInput in instance.UserInputs)
                        {
                            attempt.Variables.Add(new VariableSubmissionDto
                                {
                                    Sequence = instance.DisplayOrder,
                                    Step = instance.OriginalStepNumber,
                                    VariableName = userInput.Name,
                                    VariableValue = userInput.IsArray ? string.Join(",", userInput.ArrayCellValues.Select(c => c ?? "")) : (userInput.CurrentValue ?? "")
                                });
                        }
                    }
                }
                else
                {
                    // Если состояния нет ИЛИ оно пустое, создаем заглушку
                    Console.WriteLine($"Создание заглушки для пропущенного задания TestId: {taskInfo.TestId}");
                    attempt = new TestAttemptDto
                        {
                            TestId = taskInfo.TestId,
                            Variables = new List<VariableSubmissionDto>
                    {
                        // Создаем одну переменную-заглушку, как вы описали
                        new VariableSubmissionDto
                        {
                            Sequence = 1,
                            Step = 1,
                            VariableName = "skip", // или "string", или другое понятное значение
                            VariableValue = "0" // или "string"
                        }
                    }
                        };
                }
                allTestAttemptsForSession.Add(attempt);
            }

            if (!allTestAttemptsForSession.Any())
            {
                Console.WriteLine("Нет данных для отправки на итоговую оценку по сессии.");
                await ProcessSessionCompletion("completed_no_data_final", null);
                IsProcessingAction = false;
                StateHasChanged();
                return;
            }

            var finalRequest = new EvaluationUpdateRequestDto
                {
                    UserId = userId,
                    SessionId = SessionId,
                    Type = (int)currentTestMode,
                    Tests = allTestAttemptsForSession
                };

            await ClearTables();

            lastEvaluationResult = await EvaluationService.UpdateEvaluationAsync(finalRequest);
            await ProcessSessionCompletion(
                currentTestMode == PreTestPage.TestMode.Control ? "control_completed_final" : "training_completed_final",
                lastEvaluationResult?.Score
            );
            // IsProcessingAction сбросится в ProcessSessionCompletion
        }
        // IsProcessingAction = false; // Снимается в ProcessSessionCompletion или если не последний шаг
    }

