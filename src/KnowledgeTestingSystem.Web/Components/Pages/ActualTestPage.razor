    private Dictionary<int, string?> algorithmImageCache = new Dictionary<int, string?>();

    private async Task SetCurrentTask(int index, bool initialSetup = false)
    {
        if (sessionTasks == null || !sessionTasks.Any()) { /* ... */ return; }
        if (index < 0) index = 0;
        if (index >= sessionTasks.Count) index = sessionTasks.Count - 1;

        // Если это не первоначальная установка и задание то же самое, ничего не делаем
        if (!initialSetup && currentTask != null && currentTask.TestId == sessionTasks[index].TestId && currentTaskIndex == index) return;
        if (!initialSetup && currentTask != null) // Не сохраняем при самой первой установке из OnParametersSetAsync
        {
            SaveCurrentTaskStateToFullState(); // Сохраняем данные уходящего задания
            await SaveFullSessionStateAsync(); // Сохраняем весь стейт в SessionStorage
        }
        currentTaskIndex = index;
        currentTask = sessionTasks[index];

        for (int i = 0; i < sessionTasks.Count; i++) sessionTasks[i].IsCurrent = (i == index);

        currentTaskFormulation = currentTask.Description;
        taskImageUrl = null;
        InitialStateDescription = currentTask.TaskInitialStateDescription;

        if (currentTask != null)
        {
            // Загружаем или берем из кэша изображение алгоритма
            if (algorithmImageCache.TryGetValue(currentTask.AlgorithmId, out var cachedUrl))
            {
                taskImageUrl = cachedUrl;
                Console.WriteLine($"Изображение для AlgoId {currentTask.AlgorithmId} взято из кэша.");
            }
            else
            {
                Console.WriteLine($"Запрос изображения для AlgoId {currentTask.AlgorithmId}...");
                taskImageUrl = await AlgorithmService.GetAlgorithmPictureUrlAsync(currentTask.AlgorithmId);
                if (taskImageUrl != null)
                {
                    algorithmImageCache[currentTask.AlgorithmId] = taskImageUrl;
                    Console.WriteLine($"Изображение для AlgoId {currentTask.AlgorithmId} загружено и закэшировано.");
                }
                else
                {
                    algorithmImageCache[currentTask.AlgorithmId] = null; // Кэшируем факт отсутствия, чтобы не запрашивать снова
                    Console.WriteLine($"Не удалось загрузить изображение для AlgoId {currentTask.AlgorithmId}.");
                }
            }

            //StepZeroUserInputs.Clear();
            DisplayedStepInstances.Clear();
            //StepZeroOverallStatus = StepStatus.NotChecked;
            //StepZeroErrorMessage = null;

            try
            {
                var stateResult = await ProtectedSessionStore.GetAsync<TestSessionTaskState>(TaskSpecificStateKey(currentTask.TestId));
                if (stateResult.Success && stateResult.Value != null)
                {
                    //StepZeroUserInputs = stateResult.Value.StepZeroInputs.Select(CloneVariableInputData).ToList() ?? new List<VariableInputData>();
                    DisplayedStepInstances = stateResult.Value.DisplayedSteps.Select(CloneActiveStepInstance).ToList() ?? new List<ActiveStepInstance>();
                    ReindexDisplayedSteps();
                    Console.WriteLine($"Состояние UI восстановлено для задания {currentTask.TestId}");
                }
                else
                {
                    InitializeStepZeroInputsForCurrentTask(); // Если нет сохраненного
                    Console.WriteLine($"Состояние UI инициализировано для нового задания {currentTask.TestId}");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка восстановления состояния для задания {currentTask.TestId}: {ex.Message}");
                InitializeStepZeroInputsForCurrentTask();
            }
        }
        UpdateNextButtonText();
        if (!initialSetup) StateHasChanged();
    }

    private void UpdateNextButtonText()
    {
