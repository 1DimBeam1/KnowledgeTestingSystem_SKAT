    private async Task ProcessSessionCompletion(string reason, float? finalScore)
    {
        Console.WriteLine($"Завершение сессии {SessionId}. Причина: {reason}. Итоговый Score: {finalScore}");
        _timer?.Dispose(); _timer = null;
        // IsProcessingAction уже должен быть true

        if (finalScore.HasValue)
        {
            try { await ProtectedSessionStore.SetAsync(FinalScoreKey, finalScore.Value); } catch { }
        }
        else if (reason.Contains("timeout") || reason.Contains("no_data"))
        { // Если нет балла, но сессия завершилась
            try { await ProtectedSessionStore.SetAsync(FinalScoreKey, 0f); } catch { } // Сохраняем 0 или спец. значение
        }

        // TODO: Сохранить итог сессии (UserId, SessionId, finalScore, reason) в вашу основную БД (Db)

        await ClearAllWorkingSessionDataAsync(); // Новый метод для очистки всего, КРОМЕ FinalScoreKey

        IsProcessingAction = false; // Разблокируем перед навигацией
        StateHasChanged();
        NavigationManager.NavigateTo($"/session-results/{SessionId}?reason={reason}");
    }

